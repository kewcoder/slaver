{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slaver-harness",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": {
          "dockerfile": "./Dockerfile",
          "build_context": "."
        }
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      }
    ],
    "exports": {
      "Sandbox": {
        "type": "durable-object",
        "storage": "sqlite"
      }
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slaver_db",
      "database_id": "715313cd-e33e-432d-bfc2-c03222437800"
    }
  ]
}
