{
  "name": "slaver",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "docker compose up --build",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:server": "cargo run",
    "build:frontend": "npm --workspace frontend run build",
    "build:server": "cargo build --release",
    "build": "npm run build:frontend && npm run build:server",
    "deploy": "fly deploy",
    "typecheck:frontend": "npm --workspace frontend run typecheck",
    "typecheck:server": "cargo check"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "tailwindcss": "^4.3.4"
  }
}
