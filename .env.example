# Copy to .env and fill in. Never commit .env.
JWT_SECRET="change-me-to-a-random-string-min-32-chars"
PORT="8080"

# HitPay (get a SANDBOX key at https://dashboard.sandbox.hit-pay.com > Settings > API Keys).
# Leave HITPAY_API_KEY empty to keep the instant mock checkout.
HITPAY_API_KEY=""
# Sandbox default (production: https://api.hit-pay.com)
HITPAY_BASE_URL="https://api.sandbox.hit-pay.com"
# Optional: HMAC salt of your webhook endpoint (Developers > Webhooks). Extra authenticity check.
HITPAY_WEBHOOK_SALT=""
# Public base URL used for HitPay redirect/webhook callbacks.
APP_BASE_URL="http://localhost:8080"
