# Required. Break-glass owner token (min 32 chars). Generate: openssl rand -hex 32
ADMIN_TOKEN=

# Optional. AI features use Meta Model API (Muse Spark). Get a key at dev.meta.ai.
# Without a key: ad copy uses templates and the AI camera reports "not configured".
MODEL_API_KEY=
# Defaults shown; change only to use another OpenAI-compatible endpoint.
AI_BASE_URL=https://api.meta.ai/v1
AI_TEXT_MODEL=muse-spark-1.3
AI_VISION_MODEL=muse-spark-1.3

# Optional overrides
PORT=8080
DB_PATH=./data/fnb.db
