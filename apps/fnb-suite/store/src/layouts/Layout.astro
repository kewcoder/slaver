---
interface Props {
  title: string;
  shopName: string;
}
const { title, shopName } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {shopName}</title>
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; font: 16px/1.5 system-ui, -apple-system, sans-serif; color: #1d2330; background: #faf7f2; }
      header { display: flex; justify-content: space-between; align-items: center; padding: 14px 20px; background: #fff; border-bottom: 1px solid #ece7de; position: sticky; top: 0; }
      header a { color: #1d2330; text-decoration: none; margin-left: 16px; font-weight: 500; }
      header .brand { font-weight: 800; margin: 0; }
      main { max-width: 900px; margin: 0 auto; padding: 24px 20px 60px; }
      h1 { font-size: 28px; margin: 0 0 8px; }
      h2 { font-size: 20px; margin: 28px 0 10px; }
      .muted { color: #6b7280; font-size: 14px; }
      .card { background: #fff; border: 1px solid #ece7de; border-radius: 12px; padding: 14px; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
      .row { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px dashed #ece7de; }
      .btn, button { display: inline-block; background: #b45309; color: #fff; border: 0; border-radius: 8px; padding: 9px 14px; font: inherit; text-decoration: none; cursor: pointer; }
      .btn.ghost, button.ghost { background: #e7e1d6; color: #1d2330; }
      button:disabled { opacity: .5; cursor: default; }
      input, select, textarea { font: inherit; padding: 8px 10px; border: 1px solid #d6cfc2; border-radius: 8px; background: #fff; width: 100%; }
      label { display: flex; flex-direction: column; gap: 4px; margin: 10px 0; font-size: 14px; }
      .badge { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 13px; background: #e7e1d6; }
      .badge.ok { background: #dcfce7; color: #166534; }
      .badge.warn { background: #fef3c7; color: #92400e; }
      .badge.bad { background: #fee2e2; color: #991b1b; }
      .msg { padding: 10px 12px; border-radius: 8px; margin: 10px 0; background: #fee2e2; color: #991b1b; }
      .msg.ok { background: #dcfce7; color: #166534; }
      .inline { display: flex; gap: 8px; align-items: end; flex-wrap: wrap; }
      .inline > * { flex: 1; min-width: 120px; }
      .inline > button { flex: 0; }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="brand">{shopName}</a>
      <nav>
        <a href="/menu">Menu</a>
        <a href="/meja">Meja</a>
        <a href="/keranjang">Keranjang</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
