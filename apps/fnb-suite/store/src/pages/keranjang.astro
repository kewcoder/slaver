---
import Layout from "../layouts/Layout.astro";
import { mcp, rupiah, ensureCart } from "../lib/mcp";

const info = await mcp<any>("shop_info");
const cartId = await ensureCart(Astro);
let error: string | null = null;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const intent = String(f.get("intent"));
  try {
    if (intent === "remove") {
      await mcp("cart_remove_item", { cart_id: cartId, cart_item_id: Number(f.get("cart_item_id")) });
    } else if (intent === "promo") {
      const code = String(f.get("code") ?? "").trim();
      await mcp("cart_apply_promo", { cart_id: cartId, code: code || null });
    }
    return Astro.redirect("/keranjang");
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
  }
}

const cart = await mcp<any>("cart_get", { cart_id: cartId });
---
<Layout title="Keranjang" shopName={info.shop_name ?? "Toko"}>
  <h1>Keranjang</h1>
  {error && <div class="msg">{error}</div>}

  {cart.items.length === 0 ? (
    <p class="muted">Keranjang kosong. <a href="/menu">Lihat menu</a>.</p>
  ) : (
    <>
      <div class="card">
        {cart.items.map((i: any) => (
          <div class="row">
            <div>
              {i.qty}× {i.product_name}
              {i.addon_name && <span class="muted"> + {i.addon_name}</span>}
            </div>
            <div>
              {rupiah(i.line_total_idr)}
              <form method="post" style="display:inline">
                <input type="hidden" name="intent" value="remove" />
                <input type="hidden" name="cart_item_id" value={i.cart_item_id} />
                <button class="ghost" style="margin-left:8px">Hapus</button>
              </form>
            </div>
          </div>
        ))}
        <div class="row"><span>Subtotal</span><span>{rupiah(cart.subtotal_idr)}</span></div>
        {cart.discount_idr > 0 && (
          <div class="row"><span>Promo {cart.promo?.name}</span><span>-{rupiah(cart.discount_idr)}</span></div>
        )}
        <div class="row" style="font-weight:700;border:0"><span>Total</span><span>{rupiah(cart.total_idr)}</span></div>
      </div>

      <h2>Kode promo</h2>
      <form method="post" class="inline">
        <input type="hidden" name="intent" value="promo" />
        <input name="code" placeholder="Masukkan kode" />
        <button>Terapkan</button>
      </form>
      {cart.promo_error && <div class="msg">{cart.promo_error}</div>}
      {cart.promo && <p class="muted">Kode {cart.promo.code} aktif.</p>}

      <p style="margin-top:20px"><a class="btn" href="/checkout">Lanjut ke checkout</a></p>
    </>
  )}
</Layout>
