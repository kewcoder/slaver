---
import Layout from "../layouts/Layout.astro";
import { mcp, rupiah } from "../lib/mcp";

const info = await mcp<any>("shop_info");
const promos = await mcp<any[]>("promo_list");
const banners = await mcp<any[]>("ad_banners");
const shopName = info.shop_name ?? "Toko";
---
<Layout title="Beranda" shopName={shopName}>
  {banners.length > 0 && (
    <div class="grid" style="margin-bottom:18px">
      {banners.map((b) => (
        <div class="card">
          <strong>{b.title}</strong>
          <div>{b.body}</div>
          {b.cta && <a class="btn" style="margin-top:8px" href="/menu">{b.cta}</a>}
        </div>
      ))}
    </div>
  )}
  <h1>{shopName}</h1>
  {info.shop_address && <p class="muted">{info.shop_address}</p>}
  {info.shop_hours && <p class="muted">Jam buka: {info.shop_hours}</p>}
  <p>
    <a class="btn" href="/menu">Pesan sekarang</a>
    <a class="btn ghost" href="/meja">Cek & booking meja</a>
  </p>

  {promos.length > 0 && (
    <>
      <h2>Promo</h2>
      <div class="grid">
        {promos.map((p) => (
          <div class="card">
            <strong>{p.name}</strong>
            <div>{p.kind === "percent" ? `Diskon ${p.value}%` : `Potongan ${rupiah(p.value)}`}</div>
            {p.min_subtotal_idr > 0 && <div class="muted">Min. belanja {rupiah(p.min_subtotal_idr)}</div>}
          </div>
        ))}
      </div>
    </>
  )}
</Layout>
