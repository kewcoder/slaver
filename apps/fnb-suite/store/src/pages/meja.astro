---
import Layout from "../layouts/Layout.astro";
import { mcp, rupiah, localToIso } from "../lib/mcp";

const info = await mcp<any>("shop_info");
const offset = Number(info.utc_offset_hours ?? 7);
const deposit = Number(info.booking_deposit_idr ?? 0);
let error: string | null = null;
let ok: string | null = null;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  try {
    const r = await mcp<any>("booking_request", {
      table_id: String(f.get("table_id")),
      customer_name: String(f.get("name") ?? "").trim(),
      phone: String(f.get("phone") ?? "").trim(),
      starts_at: localToIso(String(f.get("starts_at")), offset),
      party_size: Number(f.get("party_size")),
    });
    ok = `Permintaan booking diterima (kode ${r.id}). ${deposit > 0 ? `DP ${rupiah(deposit)} dibayar saat konfirmasi.` : ""}`;
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
  }
}

const party = Number(Astro.url.searchParams.get("party") ?? 2) || 2;
const tables = await mcp<any[]>("table_availability", { party_size: party });
const minDate = new Date(Date.now() + offset * 3600_000 + 60 * 60_000).toISOString().slice(0, 16);
---
<Layout title="Meja" shopName={info.shop_name ?? "Toko"}>
  <h1>Meja</h1>
  {ok && <div class="msg ok">{ok}</div>}
  {error && <div class="msg">{error}</div>}

  <form method="get" class="inline">
    <label>Jumlah orang<input type="number" name="party" min="1" value={party} /></label>
    <button class="ghost">Cari</button>
  </form>

  <h2>Meja untuk {party} orang</h2>
  {tables.length === 0 && <p class="muted">Tidak ada meja yang muat untuk {party} orang.</p>}
  <div class="grid">
    {tables.map((t) => (
      <div class="card">
        <strong>{t.name}</strong>
        <div class="muted">Kapasitas {t.capacity}</div>
        <div>
          <span class={`badge ${t.status === "available" ? "ok" : "warn"}`}>
            {t.status === "available" ? "Kosong" : t.status === "occupied" ? "Terisi" : t.status === "reserved" ? "Dipesan" : "Dibersihkan"}
          </span>
        </div>
      </div>
    ))}
  </div>

  <h2>Booking meja</h2>
  <form method="post" class="card">
    <label>
      Meja
      <select name="table_id" required>
        {tables.map((t) => <option value={t.id}>{t.name} (kapasitas {t.capacity})</option>)}
      </select>
    </label>
    <label>Waktu<input type="datetime-local" name="starts_at" min={minDate} required /></label>
    <label>Jumlah orang<input type="number" name="party_size" min="1" value={party} required /></label>
    <label>Nama<input name="name" required /></label>
    <label>No. HP / WhatsApp<input name="phone" required /></label>
    {deposit > 0 && <p class="muted">DP booking {rupiah(deposit)}. Tanpa DP meja tidak dipegang.</p>}
    <button disabled={tables.length === 0}>Ajukan booking</button>
  </form>
</Layout>
