---
import Layout from "../layouts/Layout.astro";
import { mcp, rupiah, ensureCart, StoreError } from "../lib/mcp";

const info = await mcp<any>("shop_info");
const cartId = await ensureCart(Astro);
let error: string | null = null;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  try {
    const addon = String(f.get("addon_id") ?? "");
    await mcp("cart_add_item", {
      cart_id: cartId,
      product_id: String(f.get("product_id")),
      qty: Number(f.get("qty") ?? 1),
      addon_id: addon || undefined,
    });
    return Astro.redirect("/menu?added=1");
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
  }
}

const menu = await mcp<any[]>("catalog_list");
const categories = [...new Set(menu.map((p) => p.category || "Lainnya"))];
const added = Astro.url.searchParams.get("added") === "1";
---
<Layout title="Menu" shopName={info.shop_name ?? "Toko"}>
  <h1>Menu</h1>
  {added && <div class="msg ok">Ditambahkan ke keranjang.</div>}
  {error && <div class="msg">{error}</div>}

  {categories.map((cat) => (
    <>
      <h2>{cat}</h2>
      {menu
        .filter((p) => (p.category || "Lainnya") === cat)
        .map((p) => (
          <div class="card" style="margin-bottom:12px">
            <div class="row" style="border:0;padding:0">
              <div>
                <strong>{p.name}</strong>
                {p.description && <div class="muted">{p.description}</div>}
                <div>{rupiah(p.price_idr)}</div>
                <div class="muted">{p.available === null ? "Tersedia" : p.available > 0 ? `Sisa ${p.available}` : "Habis"}</div>
              </div>
            </div>
            <form method="post" class="inline" style="margin-top:8px">
              <input type="hidden" name="product_id" value={p.id} />
              <label style="flex:0 0 90px">
                Jumlah
                <input type="number" name="qty" value="1" min="1" max={p.available ?? 99} />
              </label>
              {p.addons.length > 0 && (
                <label>
                  Tambahan
                  <select name="addon_id">
                    <option value="">Tanpa tambahan</option>
                    {p.addons.map((a: any) => (
                      <option value={a.id} disabled={a.available === 0}>
                        {a.name} (+{rupiah(a.price_idr)}){a.available === 0 ? " habis" : ""}
                      </option>
                    ))}
                  </select>
                </label>
              )}
              <button disabled={p.available === 0}>Tambah</button>
            </form>
          </div>
        ))}
    </>
  ))}
</Layout>
