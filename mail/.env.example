# Domain pengirim. Disarankan SUBDOMAIN khusus kirim, mis. mail.slaver.app,
# supaya reputasi email marketing/transaksional tidak menodai domain utama.
MAIL_DOMAIN="mail.slaver.app"

# Akun email untuk Slaver (dibuat manual setelah container jalan, lihat README).
# Contoh: notif@mail.slaver.app
MAIL_USER="notif@mail.slaver.app"
MAIL_PASS="ganti-dengan-password-kuat"
