{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slaver Desktop",
  "version": "0.1.0",
  "identifier": "com.slaver.desktop",
  "build": {
    "frontendDist": "../loader",
    "beforeBuildCommand": "npm run bundle"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/frontend", "resources/migrations"]
  }
}
